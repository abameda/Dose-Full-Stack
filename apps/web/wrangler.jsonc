// The one Worker that serves the storefront, the studio, the admin and the API (Milestone 1).
// `astro build` writes the deployable config (dist/server/wrangler.json) from this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // DÖSE's own Cloudflare account (decision 0008); the only account this repository deploys to.
  "account_id": "a61331a1643fa91a513c9cb775d7d619",
  // The top level is local development and the fail-closed default; the cloud Workers are the
  // environments below (`CLOUDFLARE_ENV=<name> astro build`, see docs/runbooks/environments.md).
  // No Worker is bound to production in Milestone 1, so there is no `production` environment.
  "name": "dose-web",
  // The Astro request handler plus the cron's scheduled handler.
  "main": "./src/worker-scheduled.ts",
  "compatibility_date": "2026-10-01",
  // `pg` needs Node's net, tls and crypto (belief B10).
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Never deployed (each environment below has its own); `wrangler dev` never reads it.
      "id": "00000000000000000000000000000000",
      // Local Postgres of docker-compose.yml as the application role; fixed, dev-only values.
      // Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (the e2e tests do).
      "localConnectionString": "postgres://dose_app:dose_app_local@127.0.0.1:54329/dose"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dose-media" }],
  "vars": {
    // local | test | preview | staging | production. Only `local` accepts X-Dev-Staff-Email, so
    // the checked-in default fails closed: a deploy without an override is `production`, which
    // refuses to start the API without the Access vars below. Opt into `local` per run: e2e
    // passes `--var ENVIRONMENT:local`; for `astro dev` copy .dev.vars.example to .dev.vars.
    "ENVIRONMENT": "production",
    // Cloudflare Access (Task 17/18). Empty on a developer machine, where nothing sits in front.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Expire stale cash-on-delivery orders, then drain the outbox.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // Bindings and vars are not inherited by environments, so each declares all of its own. Neither
  // has an R2 bucket (an empty list): until launch the build serves the seed photos as static
  // assets (decision 0011).
  // The placement hint keeps the Worker beside the Neon database in Frankfurt (belief B1).
  "env": {
    // dose-web-staging: deployed from main by .github/workflows/staging.yml. Each pull request's
    // preview is an uploaded (never deployed) version of this Worker with its own Hyperdrive config
    // (.github/workflows/preview.yml), served at https://pr-<n>-dose-web-staging.<subdomain>.workers.dev.
    "staging": {
      // Preview URLs are off unless asked for; a staging deploy with this turns them on.
      "preview_urls": true,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "50106e4cc55d4ce5bd26f93a1a5b49a0" }],
      "vars": {
        "ENVIRONMENT": "staging",
        // Filled in after the Cloudflare Access setup (Task 17/18).
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      // No R2 bucket until launch (decision 0011). Wrangler still warns that MEDIA is top-level only.
      "r2_buckets": [],
      "placement": { "region": "aws:eu-central-1" },
      "triggers": { "crons": ["*/5 * * * *"] },
      "observability": { "enabled": true }
    },
    // dose-web-poc: the proof-of-concept Worker; no cron, so it never expires or drains anything.
    "poc": {
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "16583f17bc9d45349915598b9ef8e5a5" }],
      "vars": {
        "ENVIRONMENT": "staging",
        // Filled in after the Cloudflare Access setup (Task 17/18).
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        // The Node container's origin for /poc/latency (Task 19), filled in when it is deployed. Its
        // bearer token is the Worker secret POC_TOKEN (`wrangler secret put`), never in this file.
        "POC_CONTAINER_URL": ""
      },
      // No R2 bucket until launch (decision 0011). Wrangler still warns that MEDIA is top-level only.
      "r2_buckets": [],
      "placement": { "region": "aws:eu-central-1" },
      "triggers": { "crons": [] },
      "observability": { "enabled": true }
    }
  }
}

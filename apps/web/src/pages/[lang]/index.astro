---
// The home page of each language: Direction 0's, fed with the published products.
import HomePage from '@dose/d0-baseline/HomePage.astro';
import { loadProducts } from '../../storefront';

export const prerender = false;

const lang = Astro.locals.lang;
if (lang === null || Astro.params.lang !== lang) {
  return new Response('Not found', { status: 404 });
}
const products = await loadProducts(lang);
---

<HomePage lang={lang} products={products} />

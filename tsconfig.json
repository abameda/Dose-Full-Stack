{
  // Root-level TypeScript outside the workspace packages: the Playwright config and the e2e specs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The specs pass functions to `page.evaluate`, which run in the browser.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "e2e"]
}
